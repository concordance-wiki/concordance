{
  "openapi": "3.1.0",
  "info": { "title": "API Versements", "version": "2.0.0" },
  "paths": {
    "/versements": {
      "get": {
        "operationId": "listPayments",
        "summary": "Lister les versements d'un contrat",
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "operationId": "createPayment",
        "summary": "Créer un versement",
        "responses": { "201": { "description": "Créé" }, "409": { "description": "Plafond dépassé" } }
      }
    },
    "/versements/{id}": {
      "get": {
        "operationId": "getPayment",
        "summary": "Lire un versement",
        "responses": { "200": { "description": "OK" } }
      }
    }
  }
}
