{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordance-wiki.github.io/concordance/schemas/lock.schema.json",
  "title": "Concordance lock",
  "description": "Schema of concordance.lock.yaml, the record of human decisions. Only rejected_terms is read by the first version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "rel"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "rel": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "by": {
                "type": "string"
              },
              "at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "rejected": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "rel"
            ],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              },
              "rel": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "duplicates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merged": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        },
        "separated": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rejected_terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
