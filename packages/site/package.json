{
  "name": "@concordance-wiki/site",
  "version": "0.0.0",
  "description": "Site generation: slots, default theme, islands, stylesheet and page budget.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "@concordance-wiki/i18n": "workspace:*",
    "@concordance-wiki/profile": "workspace:*",
    "esbuild": "0.28.2",
    "preact": "10.29.8",
    "preact-render-to-string": "6.7.0"
  },
  "devDependencies": {
    "@concordance-wiki/fixture-plugin-theme-example": "workspace:*",
    "@concordance-wiki/fixture-plugin-theme-white-label": "workspace:*",
    "axe-core": "4.13.0",
    "happy-dom": "20.14.5"
  }
}
