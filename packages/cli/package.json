{
  "name": "@concordance-wiki/cli",
  "version": "0.0.0",
  "description": "The concordance command: build, render, init, validate-config, lint.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "concordance": "./dist/bin.js",
    "conc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/checks": "workspace:*",
    "@concordance-wiki/core": "workspace:*",
    "@concordance-wiki/inference": "workspace:*",
    "@concordance-wiki/ingest": "workspace:*",
    "@concordance-wiki/lint": "workspace:*",
    "@concordance-wiki/nlp": "workspace:*",
    "@concordance-wiki/profile": "workspace:*",
    "@concordance-wiki/site": "workspace:*",
    "@concordance-wiki/typing": "workspace:*"
  },
  "devDependencies": {
    "preact": "10.29.8"
  }
}
