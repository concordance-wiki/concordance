{
  "name": "@concordance-wiki/cli",
  "version": "0.1.0",
  "description": "The concordance command: build, render, init, validate-config, lint.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/cli#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": [
    "./dist/bin.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "concordance": "./dist/bin.js",
    "conc": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bin": "./dist/bin.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/checks": "workspace:*",
    "@concordance-wiki/core": "workspace:*",
    "@concordance-wiki/inference": "workspace:*",
    "@concordance-wiki/ingest": "workspace:*",
    "@concordance-wiki/lint": "workspace:*",
    "@concordance-wiki/nlp": "workspace:*",
    "@concordance-wiki/profile": "workspace:*",
    "@concordance-wiki/site": "workspace:*",
    "@concordance-wiki/typing": "workspace:*"
  },
  "devDependencies": {
    "@concordance-wiki/plugin-contract-openapi": "workspace:*",
    "@concordance-wiki/plugin-contract-wsdl": "workspace:*",
    "@concordance-wiki/plugin-convert-libreoffice": "workspace:*",
    "@concordance-wiki/plugin-reader-office": "workspace:*",
    "@concordance-wiki/plugin-reader-vtt": "workspace:*",
    "preact": "10.29.8"
  }
}
