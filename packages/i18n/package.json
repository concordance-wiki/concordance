{
  "name": "@concordance-wiki/i18n",
  "version": "0.3.0",
  "description": "Message catalogues of the generated site and their build-time resolution.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/i18n"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/i18n#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "@formatjs/icu-messageformat-parser": "3.5.18",
    "intl-messageformat": "11.2.15"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
