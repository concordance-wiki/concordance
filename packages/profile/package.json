    "base.yaml",
    "default.yaml",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "ajv": "8.20.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
