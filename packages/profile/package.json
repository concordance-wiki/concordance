{
  "name": "@concordance-wiki/profile",
  "version": "1.0.1",
  "description": "Profile loading, validation and merge; the allowed relation matrix.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/profile"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/profile#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
