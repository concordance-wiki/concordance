{
  "name": "@concordance-wiki/core",
  "version": "0.4.1",
  "description": "Model types, identifiers, canonical sorting, deterministic utilities and the plugin API.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/core#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "picomatch": "4.0.7",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/picomatch": "4.0.3",
    "vitest": "4.1.11"
  }
}
