{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordance-wiki.github.io/concordance/schemas/model.schema.json",
  "title": "Concordance model",
  "description": "Schema of dist/model.json, the canonical serialised model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "build", "entities", "links", "findings", "candidates"],
  "properties": {
    "version": {
      "const": 1
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "at", "profile_hash", "sources"],
      "properties": {
        "tool": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "profile_hash": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string"
              },
              "commit": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "description": "URL of a git source; absent for a local folder"
              },
              "locale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              },
              "files": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "counts": {
          "type": "object"
        },
        "cross_source_links": {
          "type": "boolean",
          "description": "Whether the build resolved links across sources (inference.cross_source_links); the global lint reads it to tell a broken cross-source link from a disabled one"
        },
        "contracts": {
          "type": "array",
          "description": "The contracts imported by the build, with the version each one declares and its import date",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["api", "location", "title", "version", "fingerprint", "imported_at"],
            "properties": {
              "api": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
              },
              "location": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "fingerprint": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "imported_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "locale", "type_origin", "source"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
          },
          "type": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "title": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "locale": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "application": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "domain": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "type_origin": {
            "type": "string",
            "pattern": "^(source|rule#[0-9]+|suffix|frontmatter|contract|default)$"
          },
          "graph": {
            "type": "string",
            "enum": ["full", "documents-only"],
            "description": "documents-only for a raw source that only enters the graph through the documents relation"
          },
          "attributes": {
            "type": "object"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "line"],
            "properties": {
              "name": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "commit": {
                "type": "string"
              },
              "last_modified": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "representations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "format"],
              "properties": {
                "path": {
                  "type": "string"
                },
                "format": {
                  "type": "string"
                },
                "preview": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "description": "contract when the representation is an operation of an imported contract; absent for a file of the source"
                },
                "operation": {
                  "type": "string",
                  "description": "the operation name as the contract writes it, for a contract representation"
                }
              }
            }
          },
          "grouped_by": {
            "type": "string",
            "description": "what merged the representations of this entity, for the page to name it"
          },
          "keyword": {
            "type": "boolean",
            "description": "true for a keyword page without a note"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "confidence", "provenance"],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
          },
          "to": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
          },
          "relation": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "attributes": {
            "type": "object"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["method", "confidence"],
              "properties": {
                "method": {
                  "type": "string",
                  "enum": [
                    "explicit_link",
                    "lock_promoted",
                    "contract_import",
                    "frontmatter_ref",
                    "folder_zone",
                    "section_mention",
                    "glossary_occurrence",
                    "cooccurrence",
                    "embedding"
                  ]
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "section": {
                  "type": "string"
                },
                "attribute": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "anchor": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "operation": {
                  "type": "string"
                },
                "count": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Number of paragraphs where both entities appear, for cooccurrence"
                },
                "occurrences": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["line", "context"],
                    "properties": {
                      "line": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "position": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "context": {
                        "type": "string"
                      },
                      "section": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "severity", "message", "remediation"],
        "properties": {
          "check": {
            "type": "string",
            "pattern": "^[EWI]-[A-Z0-9]+(-[A-Z0-9]+)*$"
          },
          "severity": {
            "type": "string",
            "enum": ["error", "warning", "info"]
          },
          "message": {
            "type": "string"
          },
          "remediation": {
            "type": "string"
          },
          "entity": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
          },
          "source": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "candidates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "duplicates"],
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "score", "occurrences", "documents"],
            "properties": {
              "text": {
                "type": "string"
              },
              "normalized": {
                "type": "string"
              },
              "score": {
                "type": "number"
              },
              "occurrences": {
                "type": "integer"
              },
              "documents": {
                "type": "integer"
              },
              "page": {
                "type": "boolean"
              },
              "contexts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "line", "context"],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "line": {
                      "type": "integer"
                    },
                    "context": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "objects": {
          "type": "array",
          "description": "Objects named by an imported contract that have no note; offered, never linked automatically",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "from", "contract"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["object"]
              },
              "name": {
                "type": "string"
              },
              "from": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9._-]*)+$"
              },
              "contract": {
                "type": "string"
              }
            }
          }
        },
        "duplicates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["resources", "score"],
            "properties": {
              "resources": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "string"
                }
              },
              "score": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "signals": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "neighbours": {
      "type": "object",
      "description": "K best co-occurrence neighbours per entity identifier",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["id", "count"],
          "properties": {
            "id": {
              "type": "string"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "displayed_neighbourhood": {
      "type": "object",
      "description": "One-hop neighbours shown on the page of each entity identifier, best first, at most site.neighbourhood.size of them",
      "additionalProperties": {
        "type": "array",
        "maxItems": 12,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "title", "type", "kind", "relation", "direction", "confidence"],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": ["entity", "keyword"],
              "description": "keyword for a noteless word, entity for a typed entity"
            },
            "relation": {
              "type": "string",
              "description": "relation of the most confident link between the two nodes"
            },
            "direction": {
              "type": "string",
              "enum": ["out", "in", "both"],
              "description": "where the links point, seen from the entity whose page this is"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "largest confidence over the links between the two nodes"
            }
          }
        }
      }
    }
  }
}
