{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concordance-wiki.github.io/concordance/schemas/theme.schema.json",
  "title": "Concordance theme",
  "description": "Schema of theme.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "light", "dark"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "logo": {
      "description": "Path of the logo shown before the name in the header, relative to this file; an SVG is inlined so that it can follow the current colour.",
      "type": "string"
    },
    "favicon": {
      "description": "Path of the favicon, relative to this file; copied under assets/.",
      "type": "string"
    },
    "font": {
      "description": "Font families by role. A project ships the font files itself, under assets, with @font-face rules in its stylesheet: the site never loads a font from a third-party host.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "display": {
          "type": "string"
        },
        "ui": {
          "type": "string"
        },
        "mono": {
          "type": "string"
        }
      }
    },
    "radius": {
      "type": "integer",
      "minimum": 0
    },
    "light": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "surface", "border", "ink", "muted", "accent"],
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "dark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bg", "surface", "border", "ink", "muted", "accent"],
      "properties": {
        "bg": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "surface": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "border": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "ink": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "muted": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        }
      }
    },
    "default_mode": {
      "type": "string",
      "enum": ["light", "dark", "system"],
      "default": "system"
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "url"],
            "properties": {
              "label": {
                "type": "string"
              },
              "url": {
                "type": "string"
              }
            }
          }
        },
        "credit": {
          "description": "Whether the footer credits the tool with a discreet link to its repository; nothing else in the interface names it.",
          "type": "boolean",
          "default": false
        }
      }
    },
    "stylesheet": {
      "description": "Path of a stylesheet loaded after the tool's own, in the project cascade layer, relative to this file.",
      "type": "string"
    },
    "assets": {
      "description": "Path of a folder copied as-is under assets/ of the site (fonts, icons), relative to this file.",
      "type": "string"
    },
    "labels": {
      "description": "Interface labels to override, by language of a shipped catalogue then by message identifier. A value is an ICU MessageFormat message that must use exactly the variables of the source message; the build refuses an unknown identifier, a syntax error or a different set of variables.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": ["en", "fr"]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
