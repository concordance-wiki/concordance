{
  "name": "@concordance-wiki/nlp",
  "version": "0.3.1",
  "description": "Normalisation, Aho-Corasick, n-grams, C-value, MinHash and the language packs.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/nlp"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/nlp#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "locales",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "ajv": "8.18.0",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@concordance-wiki/ingest": "workspace:*",
    "vitest": "4.1.11"
  }
}
