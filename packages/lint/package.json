{
  "name": "@concordance-wiki/lint",
  "version": "0.3.0",
  "description": "The distributable linter and its packagings.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/lint"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/lint#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "@concordance-wiki/profile": "workspace:*",
    "@concordance-wiki/typing": "workspace:*",
    "@concordance-wiki/checks": "workspace:*",
    "@concordance-wiki/ingest": "workspace:*",
    "@concordance-wiki/nlp": "workspace:*",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
