{
  "name": "@concordance-wiki/lint",
  "version": "0.0.0",
  "description": "The distributable linter and its packagings.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "@concordance-wiki/profile": "workspace:*",
    "@concordance-wiki/typing": "workspace:*",
    "@concordance-wiki/checks": "workspace:*",
    "@concordance-wiki/ingest": "workspace:*",
    "@concordance-wiki/nlp": "workspace:*",
    "ajv": "8.17.1",
    "yaml": "2.8.1"
  }
}
