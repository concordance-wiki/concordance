{
  "name": "@concordance-wiki/ingest",
  "version": "0.4.0",
  "description": "Git cloning, file reading, markdown and frontmatter parsing.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "packages/ingest"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/packages/ingest#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "vitest": "4.1.11"
  }
}
