{
  "name": "concordance-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Turns git repositories of markdown into a wiki that shows where every business word is used.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -b",
    "build:binary": "node scripts/build-binary.mjs",
    "test": "vitest run --coverage",
    "lint": "eslint . && prettier --check . && pnpm -r --workspace-concurrency 1 typecheck && node scripts/validate.mjs",
    "format": "prettier --write .",
    "mutation": "stryker run",
    "licenses:update": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "reference:update": "node scripts/config-reference.mjs",
    "measure": "node scripts/measure.mjs",
    "walkthrough": "node scripts/walkthrough.mjs",
    "parity": "node scripts/parity.mjs",
    "check": "pnpm lint && pnpm build && pnpm test && pnpm mutation && node scripts/determinism.mjs && node scripts/walkthrough.mjs && node scripts/hygiene.mjs && pnpm licenses:check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "22.20.2",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "4.1.11",
    "yaml": "2.8.1"
  }
}
