{
  "name": "@concordance-wiki/plugin-contract-openapi",
  "version": "0.4.0",
  "description": "Source of endpoint entities from OpenAPI 3.x contracts declared by API notes, cached by fingerprint.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "plugins/contract-openapi"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/plugins/contract-openapi#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
