{
  "name": "@concordance-wiki/plugin-reader-office",
  "version": "0.1.0",
  "description": "Metadata reader for docx, pptx, xlsx and pdf files: properties, dates, counts and slide titles.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/concordance-wiki/concordance.git",
    "directory": "plugins/reader-office"
  },
  "homepage": "https://github.com/concordance-wiki/concordance/tree/main/plugins/reader-office#readme",
  "bugs": "https://github.com/concordance-wiki/concordance/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@concordance-wiki/core": "workspace:*",
    "fast-xml-parser": "5.11.1",
    "fflate": "0.8.3"
  }
}
